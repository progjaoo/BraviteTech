    },
    "caption": {
      "size": "0.875rem",
      "weight": 400,
      "lineHeight": 1.45,
      "source": "proposed:responsive-extension"
    },
    "wordmark": {
      "kind": "original SVG paths",
      "fontReplacementAllowed": false
    }
  },
  "space": {
    "valuesPx": [
